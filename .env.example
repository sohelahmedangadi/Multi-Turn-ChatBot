# GEMINI_API_KEY: Required for Google Gemini API calls.
# Obtain free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# GROQ_API_KEY: Background automatic fallback when Gemini quota is exhausted.
# Obtain free from https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# MONGO_URI: MongoDB connection string (e.g., mongodb+srv://... or mongodb://localhost:27017/chatbot).
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/chatbot?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing user authentication tokens.
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SERPER_API_KEY: Required for web search tool (Serper.dev).
# Obtain free at https://serper.dev (2,500 queries/month on free tier)
SERPER_API_KEY="your_serper_api_key_here"
