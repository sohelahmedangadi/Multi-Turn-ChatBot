# GEMINI_API_KEY: Required for Google Gemini API calls.
# Obtain free from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# GROQ_API_KEY: Background automatic fallback when Gemini quota is exhausted.
# Obtain free from https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# JWT_SECRET: Secret key for signing user authentication tokens.
JWT_SECRET="your_jwt_secret_key_here_min_32_chars"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# TAVILY_API_KEY: Web search fallback API key (Tavily Search API).
# Obtain free at https://tavily.com (1,000 queries/month free tier, no credit card required)
TAVILY_API_KEY="your_tavily_api_key_here"

# CHROMA_URL: Chroma Vector Database URL for Tier 2/3 vector memory search.
# Run Chroma locally with: docker run -p 8000:8000 chromadb/chroma
# Or run with Python: chroma run --path ./chroma_data
CHROMA_URL="http://localhost:8000"

# USE_REAL_EMBEDDINGS: Set to 'true' to enable Gemini embedding API (requires GEMINI_API_KEY).
# Defaults to 'false' (fast offline deterministic hashed vectors).
USE_REAL_EMBEDDINGS="false"

# ==========================================
# MODEL CONFIGURATION & FALLBACKS
# ==========================================
# Gemini Primary & Fallback Models
GEMINI_PRIMARY_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODELS="gemini-flash-latest,gemini-3.7-flash,gemini-2.5-flash-lite,gemini-3.1-pro-preview"

# Groq Primary & Fallback Models
GROQ_PRIMARY_MODEL="qwen/qwen3.8-27b"
GROQ_FALLBACK_MODELS="openai/gpt-oss-120b,openai/gpt-oss-20b,allam-2-7b"

# Vector Embedding Model (used when USE_REAL_EMBEDDINGS=true)
EMBEDDING_MODEL="gemini-embedding-001"

# Set to 'true' to immediately fail at server startup if primary model is unavailable
FAIL_ON_INVALID_MODEL="false"
