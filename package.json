{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.js",
    "dev:all": "node run-dev.mjs",
    "dev:server": "node server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "node server/index.js",
    "test": "node server/test-suite.js",
    "test:report": "node scripts/gen-test-report.js",
    "test:coverage": "c8 node server/test-suite.js",
    "test:ci": "c8 --check-coverage node server/test-suite.js",
    "gen:env": "node scripts/gen-env-table.js",
    "chroma": "python scripts/start-chroma.py --host 127.0.0.1 --port 8000",
