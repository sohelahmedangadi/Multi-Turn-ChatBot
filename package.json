    "benchmark": "node scripts/benchmark.js",
    "benchmark:report": "node scripts/gen-benchmark-report.js",
    "benchmark:rubric": "node scripts/run-rubric-benchmark.js",
    "benchmark:rubric:report": "node scripts/gen-rubric-report.js",
    "benchmark:agreement": "node scripts/agreement.js",
    "benchmark:injection": "node scripts/run-injection-benchmark.js",
    "benchmark:garak": "python scripts/run-garak.py",
    "check:models": "node scripts/check-models.js",
    "audit:npm": "npm audit",
    "audit:pip": "python -m pip_audit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@langchain/core": "^1.2.9",
