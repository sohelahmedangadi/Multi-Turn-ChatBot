    "autocannon": "^9.0.0",
    "autoprefixer": "^10.4.21",
    "c8": "^12.0.0",
    "esbuild": "^0.25.0",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
